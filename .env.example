# ---------------------------------------------------------------------------
# Environment variables
#
# Client-visible variables must use the APP_ prefix (set via
# `envOptions.envPrefix` in vite.config.ts) and are exposed to the app through
# `import.meta.env.APP_*`. Copy this file to `.env` (gitignored) to override.
#
# The same variables are also read by vite.config.ts at dev/build time via
# loadEnv(), so a single source of truth drives both the generated API client
# and the running app.
# ---------------------------------------------------------------------------

# Base URL of the Petstore API used by the generated client (app/api/petstore.ts)
APP_PETSTORE_BASE_URL=https://petstore.swagger.io/v2

# Hosted OpenAPI spec the Vite plugin generates the client from.
# After changing it, regenerate the client: pnpm api:gen (or restart pnpm dev).
APP_PETSTORE_SPEC_URL=https://petstore.swagger.io/v2/swagger.json
